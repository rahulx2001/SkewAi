# Copy to .env for docker compose / local pilot. Never commit .env.

# Pack: automotive_nhtsa | finance_cfpb
DOMAIN_PACK=automotive_nhtsa

# --- Auth (hardened pilot / any shared network) ---
# Fail-closed: set both. Leave API key empty only for local open-mode demos.
# FRONTLINE_OPEN_MODE=1 forces open even if a key is set (local only).
# Production / SOC2 engineering mode (refuses open mode at startup):
#   ENV=production   OR   PILOT_HARDENED=1   OR   SOC2_MODE=1
# ENV=
# PILOT_HARDENED=0
# SOC2_MODE=0
FRONTLINE_AUTH_REQUIRED=0
FRONTLINE_API_KEY=
SESSION_SECRET=
# SECURITY_AUDIT_LOG_PATH=data/security_audit.jsonl
# RATE_LIMIT_DEFAULT=300 per hour
# One-time: allow minting admin session without an admin issuer (then unset).
# FRONTLINE_BOOTSTRAP_ADMIN=0
# Shared API key is role "service" (not full admin). Legacy full admin:
# FRONTLINE_SERVICE_IS_ADMIN=0
# Query-string API keys off by default; tests may set:
# FRONTLINE_ALLOW_QUERY_KEY=0
# Production-like disables /docs and /openapi.json unless:
# FRONTLINE_OPENAPI_PUBLIC=0
# Pack activate / drain / pack disk write / DSR delete need admin session:
#   FRONTLINE_BOOTSTRAP_ADMIN=1 once, then POST /api/frontline/auth/session role=admin
# CORS allowlist (never use * with credentials):
# CORS_ALLOW_ORIGINS=http://127.0.0.1:8787,http://localhost:8000

# Optional outbound alert webhook (SSRF-guarded at runtime)
ALERT_WEBHOOK_URL=

# Pack install filesystem jail (default: <repo>/domains). Outside paths rejected.
# PACK_INSTALL_ROOT=
# When FRONTLINE_AUTH_REQUIRED=1, source_path install is disabled unless:
# PACK_INSTALL_ALLOW_SOURCE=1

# Optional BYOK LLM providers (runtime works without them)
CLAUDE_API_KEY=
OPENAI_API_KEY=

# Intentional pilot DB rebuilds (make frontline-db / make seed-domains):
# FRONTLINE_ALLOW_DEFAULT_DB_RESET=1
